NODE_ENV=production
DOMAIN=auth.yzlaboratory.dev
PUBLIC_BASE_URL=https://auth.yzlaboratory.dev
TRUST_PROXY=true
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://yz_auth:replace-with-uri-encoded-password@postgres:5432/yz_auth
COOKIE_KEYS=replace-with-at-least-32-random-bytes
KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
EMAIL_DRIVER=ses
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
SES_FROM_ADDRESS=no-reply@mail.yzlaboratory.dev
SES_CONFIGURATION_SET_NAME=yz-auth-transactional
EMAIL_OUTBOX_POLL_MS=1000
