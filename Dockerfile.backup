FROM postgres:17-bookworm
RUN apt-get update \
  && apt-get install -y --no-install-recommends awscli ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/backup.sh /usr/local/bin/yz-auth-backup
RUN chmod 0555 /usr/local/bin/yz-auth-backup
USER postgres
CMD ["/usr/local/bin/yz-auth-backup"]
