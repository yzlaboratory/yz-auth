NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
DATABASE_URL=postgres://yz_auth:yz_auth@localhost:5432/yz_auth
COOKIE_KEYS=replace-with-at-least-32-random-bytes
KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
EMAIL_DRIVER=smtp
EMAIL_FROM=yz-auth <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
AWS_REGION=eu-central-1
SES_FROM_ADDRESS=no-reply@mail.example.com
SES_CONFIGURATION_SET_NAME=yz-auth-transactional
