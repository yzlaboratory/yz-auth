{
  "name": "yz-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run build && shh check .",
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "prepare": "husky",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.13.1",
    "@yzlaboratory/shh": "0.1.7",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/view": "12.0.1",
    "ejs": "7.0.2",
    "fastify": "5.12.7",
    "hash-wasm": "4.12.0",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "oidc-provider": "9.13.3",
    "postgres": "4.0.0",
    "zod": "4.6.7"
  }
}
